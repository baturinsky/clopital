{
  "name": "timeless",
  "version": "1.0.0",
  "description": "Timeless",
  "author": "@baturinsky",
  "type": "module",
  "license": "BSD-3-Clause",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "min": "vite build --mode=min",
    "zip": "cd dist && npx bestzip --level 9 ../dist.zip *",
    "noexif": "node noexif.js dist/i.webp dist/i.webp",
    "packfli": "zipfli dist.zip dist/index.html dist/i.webp",
    "dist": "npm run min && npm run noexif && npm run packfli"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "esbuild": "^0.17.14",
    "preact-router": "^3.2.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0"
  },
  "dependencies": {
    "@faffweasel/strip-metadata": "^0.1.0",
    "@preact/signals": "^2.9.0",
    "bestzip": "^3.0.2",
    "compress-image": "^0.0.1",
    "css-tooltip": "^0.3.4",
    "exif-be-gone": "^1.5.1",
    "howler": "^2.2.4",
    "htm": "^3.1.1",
    "is-mobile": "^5.0.0",
    "javascript-lp-solver": "^1.0.3",
    "lp-model": "^0.4.2",
    "node-unrar-js": "^2.0.2",
    "node-zopfli": "^2.1.4",
    "simple-simplex": "^1.0.1",
    "terser": "^5.50.0",
    "vite": "^7.1.9",
    "vite-plugin-glsl": "^1.5.3",
    "vite-plugin-singlefile": "^2.3.0",
    "yalps": "^0.6.4"
  }
}
